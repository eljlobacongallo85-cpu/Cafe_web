{% extends 'base.html.twig' %}

{% block title %}Worker Dashboard{% endblock %}

{% block body %}
<div class="card shadow-lg p-4">
    <h1 class="mb-4 text-success">👨‍🍳 Worker Dashboard</h1>

    <div class="mb-3">
        <h4>Your Shift</h4>
        <p class="lead">{{ shift }}</p>
    </div>

    <h4>Assigned Orders</h4>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Item</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for order in assignedOrders %}
                <tr>
                    <td>{{ order.id }}</td>
                    <td>{{ order.item }}</td>
                    <td>
                        {% if order.status == 'Ready' %}
                            <span class="badge bg-success">{{ order.status }}</span>
                        {% elseif order.status == 'Preparing' %}
                            <span class="badge bg-warning text-dark">{{ order.status }}</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ order.status }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-center">No orders assigned.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
