<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Jelo's Cafe{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Fonts for a cafe vibe -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fdf9f3;
            color: #2f1f13;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar */
        .custom-navbar {
            background: linear-gradient(135deg, rgba(78, 45, 7, 0.92), rgba(62, 31, 2, 0.92));
            border-bottom: 4px solid rgba(240, 194, 123, 0.65);
            padding: 0;
            backdrop-filter: blur(10px);
        }

        .custom-navbar .navbar-brand {
            font-weight: 700;
            font-size: 1.6rem;
            letter-spacing: 0.8px;
            color: #fff;
        }

        .custom-navbar .navbar-brand:hover {
            color: #ffdd8f;
            text-decoration: none;
        }

        .custom-nav-link {
            font-size: 0.95rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            color: rgba(255, 255, 255, 0.85);
            margin-left: 0.75rem;
            transition: color 0.25s ease;
        }

        .custom-nav-link:hover {
            color: #ffd97b;
        }

        .custom-nav-link.active {
            color: #ffdd8f;
            border-bottom: 2px solid rgba(255, 255, 255, 0.7);
        }

        /* Main container */
        .page-wrapper {
            margin-top: 20px;
            margin-bottom: 60px;
        }

        main.page-content {
            flex: 1;
        }

        /* Footer */
        footer {
            background-color: #331d0a;
            color: #f8f5f2;
            padding: 24px 0;
            text-align: center;
            font-size: 0.95rem;
            letter-spacing: 0.3px;
        }

        footer a {
            color: #ffd97b;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        /* Shared sections */
        .page-section {
            background: #fff;
            border-radius: 28px;
            padding: 2.5rem;
            box-shadow: 0 35px 65px rgba(67, 35, 9, 0.08);
        }

        .section-heading {
            font-weight: 600;
            letter-spacing: 0.05em;
            color: #4b2e05;
        }

        .section-subtitle {
            color: #7a5b3c;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.35em;
            font-size: 0.7rem;
        }

        .gradient-hero {
            background-image: linear-gradient(135deg, rgba(75, 46, 5, 0.95), rgba(255, 214, 175, 0.95)), url('https://images.unsplash.com/photo-1503602642458-232111445657?auto=format&fit=crop&w=1500&q=80');
            background-size: cover;
            background-position: center;
            color: #fff;
            border-radius: 28px;
            position: relative;
            overflow: hidden;
            padding: 3rem;
            box-shadow: 0 40px 80px rgba(39, 18, 4, 0.25);
        }

        .gradient-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(4, 4, 4, 0.6), rgba(4, 4, 4, 0.1));
            border-radius: 28px;
        }

        .gradient-hero > * {
            position: relative;
            z-index: 1;
        }

        .menu-card {
            border-radius: 24px;
            border: 1px solid rgba(75, 46, 5, 0.1);
            background: #fff;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .menu-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.08);
        }

        .menu-card img {
            border-radius: 20px;
            object-fit: cover;
        }

        .menu-card .price-tag {
            font-size: 1.1rem;
            font-weight: 600;
            color: #4b2e05;
        }

        footer {
            background-color: rgba(51, 29, 10, 0.75);
            color: #f5e6d2;
            padding: 2rem 0;
            font-size: 0.9rem;
            backdrop-filter: blur(6px);
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        footer * {
            color: inherit;
        }

        footer h5,
        footer h6 {
            color: #fff1d8;
            margin-bottom: 0.75rem;
        }

        footer a {
            color: #ffd97b;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        .footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-links li + li {
            margin-top: 0.4rem;
        }

        .footer-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            margin-top: 2rem;
            padding-top: 1rem;
            font-size: 0.85rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 0.5rem;
        }

        /* Flash messages */
        .flash-message {
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    {% set current_route = app.request.attributes.get('_route') %}
    <nav class="navbar custom-navbar sticky-top shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="navbar-brand" href="{{ path('homepage') }}">Jelo's Cafe</a>
            <ul class="nav">
                {% set navLinks = [
                    {label: 'Home', route: 'homepage'},
                    {label: 'Menu', route: 'menu'},
                    {label: 'About', route: 'about'},
                    {label: 'Contact', route: 'contact'},
                    {label: 'Cart', route: 'view_cart'}
                ] %}

                {% for link in navLinks %}
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link{% if current_route == link.route %} active{% endif %}" href="{{ path(link.route) }}">{{ link.label }}</a>
                    </li>
                {% endfor %}

                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link{% if current_route == 'my_orders' %} active{% endif %}" href="{{ path('my_orders') }}">
                            My Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link{% if current_route == 'account_profile' %} active{% endif %}" href="{{ path('account_profile') }}">
                            Account
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link" href="{{ path('logout') }}">Logout</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link{% if current_route == 'app_login' %} active{% endif %}" href="{{ path('app_login') }}">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link custom-nav-link{% if current_route == 'app_register' %} active{% endif %}" href="{{ path('app_register') }}">Sign up</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>

    <!-- Flash messages -->
    <div class="container mt-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} flash-message text-center shadow-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main content -->
    <main class="page-content">
        <div class="container page-wrapper">
            {% block body %}{% endblock %}
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <h5>Jelo's Cafe</h5>
                    <p>Neighborhood roastery, bakery, and gathering place serving craft coffee, pastries, and warm hospitality.</p>
                    <p class="mb-0 text-muted">Follow for pop-ups, acoustic sessions, and new batch drops.</p>
                </div>
                <div class="col-lg-4">
                    <h6>Visit &amp; Contact</h6>
                    <p class="mb-1">123 Brew Street, Downtown</p>
                    <p class="mb-1">hello@jeloscafe.test</p>
                    <p>Mon-Fri 7:00 AM - 9:00 PM • Sat 8:00 AM - 10:00 PM • Sun 8:00 AM - 8:00 PM</p>
                </div>
                <div class="col-lg-4">
                    <h6>Quick Links</h6>
                    <ul class="footer-links">
                        <li><a href="{{ path('menu') }}">Menu</a></li>
                        <li><a href="{{ path('about') }}">About</a></li>
                        <li><a href="{{ path('contact') }}">Contact</a></li>
                        <li><a href="{{ path('homepage') }}">Home</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-footer">
                <span>© {{ "now"|date("Y") }} Jelo's Cafe</span>
                <span>Crafted with care in every batch</span>
                <a href="#">Back to top</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
