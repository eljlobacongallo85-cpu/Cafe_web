{
  "info": {
    "name": "Cafe API Tests",
    "description": "Minimal collection covering the rubric's API requirements: login, catalog, staff order listing, and order creation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "event": [],
  "item": [
    {
      "name": "Auth / Login (Staff)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response identifies staff\", () => pm.expect(pm.response.json().user.roles).to.include(\"ROLE_STAFF\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Products / Catalog",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Product catalog is available\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body contains products\", () => pm.expect(pm.response.json().products).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders / List (Staff)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Orders endpoint responds\", () => pm.response.to.have.status(200));",
              "pm.test(\"Payload includes ok flag\", () => pm.expect(pm.response.json().ok).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Orders / Create (Staff)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"API Guest\",\n  \"contact\": \"09171234567\",\n  \"notes\": \"Created via Postman\",\n  \"items\": [\n    { \"productId\": {{testProductId}}, \"quantity\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Create order returns 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Response exposes order id\", () => pm.expect(pm.response.json().order.id).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    }
  ]
}
