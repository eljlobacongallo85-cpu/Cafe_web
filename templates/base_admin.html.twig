<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% block title %}Admin Panel - Jelo's Cafe{% endblock %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        :root{
            --coffee:#4b2e05;
            --accent:#ffce7a;
            --bg:#fdf9f3;
            --muted:#d1c6b3;
            --paper:#ffffff;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg);
            color: #2f1f13;
            margin:0;
            display:flex;
            min-height:100vh;
        }

        /* Sidebar */
        .sidebar {
            width:260px;
            background: linear-gradient(135deg, rgba(78, 45, 7, 0.95), rgba(62, 31, 2, 0.95));
            color:#fff;
            position:fixed;
            top:0; left:0;
            height:100vh;
            padding:18px 12px;
            display:flex;
            flex-direction:column;
            border-right: 1px solid rgba(255, 255, 255, 0.12);
        }

        .brand {
            text-align:center;
            margin-bottom:16px;
            padding-bottom:14px;
            border-bottom:1px solid rgba(255, 255, 255, 0.18);
        }

        .brand h4 {
            color:#fff;
            font-weight:700;
            margin:0;
        }

        .sidebar .nav-link {
            color:#fff;
            margin:6px 6px;
            border-radius:14px;
            padding:10px 12px;
            display:flex;
            gap:10px;
            align-items:center;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
            transition: background .2s ease, transform .2s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: rgba(255, 217, 123, 0.95);
            color: #2f1f13 !important;
            font-weight:600;
            transform: translateY(-1px);
        }

        .small-muted {
            color:var(--muted);
            font-size:.85rem;
        }

        /* Main */
        .main-content {
            margin-left:260px;
            padding:28px;
            flex:1;
            background: transparent;
        }

        .topbar {
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:18px;
            padding: 18px 22px;
            border-radius: 22px;
            background: linear-gradient(135deg, rgba(75, 46, 5, 0.92), rgba(255, 214, 175, 0.92));
            color: #fff;
            box-shadow: 0 28px 55px rgba(39, 18, 4, 0.18);
        }

        .topbar h2 {
            font-weight:700;
            letter-spacing:0.4px;
        }

        .admin-page {
            background: var(--paper);
            border-radius: 28px;
            padding: 2.25rem;
            box-shadow: 0 35px 65px rgba(67, 35, 9, 0.08);
            border: 1px solid rgba(75, 46, 5, 0.08);
        }

        .flash-message {
            margin-bottom: 1rem;
        }

        .btn-coffee{
            background: var(--coffee);
            color:#fff;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 14px;
            padding: .55rem 1rem;
        }

        .btn-coffee:hover{
            background: #3a2404;
            color:#fff;
        }

        .btn-outline-coffee{
            background: transparent;
            color: var(--coffee);
            border: 1px solid rgba(75, 46, 5, 0.35);
            border-radius: 14px;
            padding: .55rem 1rem;
        }

        .btn-outline-coffee:hover{
            background: rgba(255, 217, 123, 0.35);
            color: #2f1f13;
            border-color: rgba(75, 46, 5, 0.35);
        }

        .card,
        .card-compact{
            border-radius: 22px;
            border: 1px solid rgba(75, 46, 5, 0.08);
        }

        .card-compact{
            background: #fff;
            box-shadow: 0 22px 40px rgba(67, 35, 9, 0.08);
        }

        @media (max-width:900px){
            .sidebar {
                position:static;
                width:100%;
                height:auto;
            }
            .main-content {
                margin-left:0;
            }
        }

        table.dataTable thead th {
            background: rgba(75, 46, 5, 0.92);
            color:#fff;
        }

        .table-dark{
            --bs-table-bg: rgba(75, 46, 5, 0.92);
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="sidebar">
    <div>
        <div class="brand">
            <h4>Jelo's Cafe</h4>

            {% if is_granted('ROLE_ADMIN') %}
                <span class="badge bg-warning text-dark mt-1">
                    <i class="bi bi-shield-lock"></i> Admin
                </span>
            {% elseif is_granted('ROLE_STAFF') %}
                <span class="badge bg-info text-dark mt-1">
                    <i class="bi bi-person-badge"></i> Staff
                </span>
            {% endif %}
        </div>

        <a href="{{ path('account_profile') }}"
           class="nav-link {% if app.request.get('_route') == 'account_profile' %}active{% endif %}">
            <i class="bi bi-person-circle"></i> My Profile
        </a>

        {# STAFF DASHBOARD (STAFF ONLY) #}
        {% if is_granted('ROLE_STAFF') and not is_granted('ROLE_ADMIN') %}
            <a href="{{ path('staff_dashboard') }}"
               class="nav-link {% if app.request.get('_route') == 'staff_dashboard' %}active{% endif %}">
                <i class="bi bi-speedometer"></i> Staff Dashboard
            </a>
        {% endif %}

        {# ADMIN DASHBOARD #}
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}"
               class="nav-link {% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
                <i class="bi bi-speedometer2"></i> Admin Dashboard
            </a>
        {% endif %}

        {% if is_granted('ROLE_STAFF') %}
            <a href="{{ path('admin_product_index') }}"
               class="nav-link {% if app.request.get('_route') starts with 'admin_product' %}active{% endif %}">
                <i class="bi bi-cup-hot"></i> Products
            </a>

            <a href="{{ path('admin_order_index') }}"
               class="nav-link {% if app.request.get('_route') starts with 'admin_order' %}active{% endif %}">
                <i class="bi bi-receipt"></i> Orders
            </a>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_user_index') }}"
               class="nav-link {% if app.request.get('_route') starts with 'admin_user' %}active{% endif %}">
                <i class="bi bi-people"></i> Users
            </a>

            <a href="{{ path('admin_activity') }}"
               class="nav-link {% if app.request.get('_route') == 'admin_activity' %}active{% endif %}">
                <i class="bi bi-journal-text"></i> Activity Logs
            </a>
        {% endif %}

        <a href="{{ path('logout') }}" class="nav-link"
           onclick="event.preventDefault(); document.getElementById('logout-form').submit();">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>

        <form id="logout-form" action="{{ path('logout') }}" method="post" style="display:none;">
            <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
        </form>
    </div>

    <div class="mt-auto text-center">
        <small class="small-muted">Copyright {{ "now"|date("Y") }} Jelo's Cafe</small>
    </div>
</nav>

<main class="main-content">
    <div class="topbar">
        <div>
            <h2 class="m-0">{% block header %}{% endblock %}</h2>
            <div class="text-white-50">{% block subheader %}{% endblock %}</div>
        </div>

        {% if app.user %}
            <div class="text-end">
                <div class="fw-semibold">{{ app.user.username }}</div>
                <div class="text-white-50 small">{{ app.user.email }}</div>
            </div>
        {% endif %}
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} flash-message text-center shadow-sm">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="admin-page">
        {% block body %}{% endblock %}
    </div>
</main>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
