# Example environment configuration (safe to commit)

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me

DEFAULT_URI=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOSTS=localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+

# Local DB example (Docker compose / local MySQL)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=8.0.32&charset=utf8mb4"

# Mailer (set in Railway / production variables)
MAILER_DSN=""

# Google OAuth (set in Railway / production variables)
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GOOGLE_HOSTED_DOMAIN=""

# Firebase Cloud Messaging (set in Railway / production variables)
# Paste the Firebase service-account JSON as one line, or base64-encode it.
FCM_SERVICE_ACCOUNT_JSON=""
FCM_PROJECT_ID=""

# CORS (adjust for deployed domain)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
