{% extends 'base.html.twig' %}
{% block title %}About Jelo's Cafe{% endblock %}

{% block body %}
<section class="gradient-hero mb-5 text-white">
    <p class="section-subtitle text-white-75">A neighborhood staple</p>
    <h1 class="display-4 fw-bold mb-3">About Jelo's Cafe</h1>
    <p class="lead text-white-75 mb-0">Rooted in craft, hospitality, and community collaboration since day one. We roast, bake, and welcome neighbors like family.</p>
</section>

<section class="page-section mb-5">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 24px;">
                <div class="card-body">
                    <p class="section-subtitle text-muted">Mission</p>
                    <h2 class="section-heading mb-3">We brew thoughtful coffee</h2>
                    <p>Every cup is roasted in small batches, poured with precision, and served alongside handmade pastries and warm smiles.</p>
                    <p class="text-muted mb-0">Our team champions local producers and knows your order before you arrive.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm bg-light" style="border-radius: 24px;">
                <div class="card-body">
                    <p class="section-subtitle text-muted">Values</p>
                    <h5 class="fw-semibold mb-3">What we value most</h5>
                    <ul class="mb-0 text-muted" style="padding-left: 1rem;">
                        <li>Consistency in every cup and pastry.</li>
                        <li>Collaborations with artists, students, and the neighborhood.</li>
                        <li>Warm service even on the busiest mornings.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="section-heading mb-4">Meet the team</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        {% set team = [
            { name: 'EL Jlo Bacongallo', title: 'Owner & Founder', desc: 'Guides our strategy, culture, and commitment to the community.', img: 'https://images.unsplash.com/photo-1502720705749-3c0e4e9b917c?auto=format&fit=crop&w=600&q=80' },
            { name: 'Mia Cruz', title: 'Operations Manager', desc: 'Keeps daily service on track and guests feeling at home.', img: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=600&q=80' },
            { name: 'Ana Pineda', title: 'Pastry Chef', desc: 'Dreams up seasonal desserts and savory bites.', img: 'https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?auto=format&fit=crop&w=600&q=80' },
            { name: 'Luis Rivera', title: 'Lead Coffee Maker', desc: 'Crafts every espresso shot and seasonal pour-over with precision.', img: 'https://images.unsplash.com/photo-1504593811423-6dd665756598?auto=format&fit=crop&w=600&q=80' }
        ] %}
        {% for member in team %}
            <div class="col">
                <article class="menu-card h-100 p-0 overflow-hidden">
                    <div class="ratio ratio-4x3">
                        <img src="{{ member.img }}" class="w-100 h-100" alt="{{ member.name }}">
                    </div>
                    <div class="p-4">
                        <div class="fw-bold mb-1">{{ member.name }}</div>
                        <p class="text-muted mb-2">{{ member.title }}</p>
                        <p class="text-muted small mb-0">{{ member.desc }}</p>
                    </div>
                </article>
            </div>
        {% endfor %}
    </div>
</section>

<section class="page-section text-center">
    <h3 class="section-heading mb-2">Visit and collaborate</h3>
    <p class="text-muted mb-3">We host local artists, student tastings, and private workshops every month.</p>
    <a href="{{ path('contact') }}#contact-form" class="btn btn-warning btn-lg">Reserve the space</a>
</section>
{% endblock %}
