{% extends 'base_admin.html.twig' %}
{% block title %}Products - Admin{% endblock %}
{% block header %}Products{% endblock %}

{% block body %}
<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <a href="{{ path('admin_product_new') }}" class="btn" style="background:var(--coffee); color:#fff">➕ Add New Product</a>
    </div>
    <div>
        <input class="form-control" id="productSearch" placeholder="Search products..." style="min-width:260px">
    </div>
</div>

<div class="row">
    {% for product in products %}
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                {% if product.image %}
                    <img src="{{ product.image }}" class="card-img-top" alt="{{ product.name }}" style="height:190px; object-fit:cover;">
                {% endif %}
                <div class="card-body">
                    <h5 class="card-title">{{ product.name }}</h5>
                    <p class="text-muted small mb-2">{{ product.category|default('Uncategorized') }}</p>
                    <p class="mb-1"><strong>₱{{ product.price|number_format(2, '.', ',') }}</strong></p>
                    <p class="text-secondary mb-0">{{ product.description|default('No description')|slice(0,120) ~ (product.description and product.description|length > 120 ? '…' : '') }}</p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-sm btn-warning">✏️ Edit</a>
                    <div>
                        <a href="{{ path('admin_product_show', {id: product.id}) }}" class="btn btn-sm btn-info text-white">View</a>
                        <a href="{{ path('admin_product_delete', {id: product.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Delete this product?');">🗑️</a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">No products available.</div>
        </div>
    {% endfor %}
</div>

<hr>

<table id="productTable" class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr><th>Name</th><th>Price</th><th>Category</th><th>Actions</th></tr>
    </thead>
    <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.name }}</td>
                <td>₱{{ product.price|number_format(2, '.', ',') }}</td>
                <td>{{ product.category|default('Uncategorized') }}</td>
                <td>
                    <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                    <a href="{{ path('admin_product_delete', {id: product.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Delete this product?');">Delete</a>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% block javascripts %}
<script>
    $(document).ready(function(){
        $('#productTable').DataTable({ pageLength:8, lengthMenu:[8,15,25] });
        $('#productSearch').on('input', function(){
            $('#productTable').DataTable().search(this.value).draw();
        });
    });
</script>
{% endblock %}

{% endblock %}
