{% extends 'base_admin.html.twig' %}

{% block title %}Activity Logs{% endblock %}
{% block header %}Activity Logs{% endblock %}
{% block subheader %}System activity records{% endblock %}

{% block body %}
<div class="card card-compact p-4 shadow-sm">
    <div class="alert alert-info d-flex align-items-center justify-content-between gap-3">
        <div>
            <i class="bi bi-broadcast me-1"></i>
            Activity updates enabled (<span id="activityRealtimeStatus">connecting</span>; polling fallback every <strong>8s</strong>).
        </div>
        <button id="activityRefreshBtn" type="button" class="btn btn-sm btn-outline-primary">
            Refresh now
        </button>
    </div>

    <!-- FILTERS -->
<form method="get" class="row g-2 mb-4">

    <div class="col-md-4">
        <input type="text" 
               name="username"
               value="{{ filters.username }}"
               class="form-control"
               placeholder="Filter by Username">
    </div>

    <div class="col-md-3">
        <select name="action" class="form-control">
            <option value="ALL">All Actions</option>
            <option value="CREATE" {{ filters.action == 'CREATE' ? 'selected' }}>CREATE</option>
            <option value="UPDATE USER" {{ filters.action == 'UPDATE USER' ? 'selected' }}>UPDATE</option>
            <option value="DELETE" {{ filters.action == 'DELETE' ? 'selected' }}>DELETE</option>
            <option value="LOGIN" {{ filters.action == 'LOGIN' ? 'selected' }}>LOGIN</option>
            <option value="LOGOUT" {{ filters.action == 'LOGOUT' ? 'selected' }}>LOGOUT</option>
            <option value="ADD_PRODUCT" {{ filters.action == 'LOGOUT' ? 'selected' }}>ADD_PRODUCT</option>
            <option value="DELETE_PRODUCT" {{ filters.action == 'LOGOUT' ? 'selected' }}>DELETE_PRODUCT</option>
        </select>
    </div>

    <div class="col-md-3">
        <input type="date" 
               name="date"
               value="{{ filters.date }}"
               class="form-control">
    </div>

    <div class="col-md-2">
        <button class="btn btn-coffee w-100">
            <i class="bi bi-funnel"></i> Filter
        </button>
    </div>

</form>


    <!-- LOG TABLE -->
    <table
        id="activityTable"
        class="table table-striped table-hover align-middle"
        data-feed-url="{{ path('admin_activity_feed') }}"
    >
        <thead class="table-dark">
            <tr>
                <th>User</th>
                <th>Role</th>
                <th>Action</th>
                <th>Target</th>
                <th>Date</th>
            </tr>
        </thead>

        <tbody>
        {% for log in logs %}
            <tr>
                <td><strong>{{ log.username }}</strong></td>
                <td><span class="badge bg-secondary">{{ log.role }}</span></td>

                <td>
                    {% if log.action == 'DELETE' %}
                        <span class="badge bg-danger">{{ log.action }}</span>
                    {% elseif log.action == 'UPDATE' %}
                        <span class="badge bg-warning text-dark">{{ log.action }}</span>
                    {% elseif log.action == 'CREATE' %}
                        <span class="badge bg-success">{{ log.action }}</span>
                    {% else %}
                        <span class="badge bg-info">{{ log.action }}</span>
                    {% endif %}
                </td>

                <td>{{ log.targetData }}</td>

                <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}

{% block javascripts %}
<script>
    const tableEl = document.getElementById('activityTable');
    const feedUrl = tableEl?.getAttribute('data-feed-url');
    const realtimeStatus = document.getElementById('activityRealtimeStatus');
    const dt = new DataTable('#activityTable', {
        searching: false,    // Disable DataTables search
        ordering: false,     // Disable DataTables column sorting
        lengthChange: false, // Keep pagination simple
        pageLength: 25
    });

    const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const badgeForAction = (action) => {
        const value = escapeHtml(action);
        if (action === 'DELETE') return `<span class="badge bg-danger">${value}</span>`;
        if (action === 'UPDATE') return `<span class="badge bg-warning text-dark">${value}</span>`;
        if (action === 'CREATE') return `<span class="badge bg-success">${value}</span>`;
        return `<span class="badge bg-info">${value}</span>`;
    };

    const fmtDate = (iso) => {
        try {
            if (!iso) return '-';
            const d = new Date(iso);
            const pad = (v) => String(v).padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
        } catch (e) {
            return '-';
        }
    };

    const setRealtimeStatus = (text, className = '') => {
        if (!realtimeStatus) return;
        realtimeStatus.textContent = text;
        realtimeStatus.className = className;
    };

    async function refreshActivity() {
        if (!feedUrl) return;
        try {
            const res = await fetch(feedUrl, { headers: { 'Accept': 'application/json' } });
            const data = await res.json();
            if (!data || data.ok !== true || !Array.isArray(data.logs)) return;

            const rows = data.logs.map((log) => ([
                `<strong>${escapeHtml(log.username)}</strong>`,
                `<span class="badge bg-secondary">${escapeHtml(log.role)}</span>`,
                badgeForAction(log.action),
                escapeHtml(log.targetData),
                fmtDate(log.createdAt),
            ]));

            dt.clear();
            dt.rows.add(rows).draw(false);
        } catch (e) {
            // keep existing rows
        }
    }

    document.getElementById('activityRefreshBtn')?.addEventListener('click', refreshActivity);
    setInterval(refreshActivity, 8000);

    const connectRealtime = () => {
        if (!window.WebSocket) {
            setRealtimeStatus('polling only', 'text-warning fw-semibold');
            return;
        }

        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const socket = new WebSocket(`${protocol}//${window.location.host}/ws/orders`);

        socket.addEventListener('open', () => {
            setRealtimeStatus('real-time connected', 'text-success fw-semibold');
        });

        socket.addEventListener('message', (event) => {
            try {
                const payload = JSON.parse(event.data);
                const type = String(payload?.type || '').toLowerCase();
                if (type.includes('activity') || payload?.activity) {
                    refreshActivity();
                }
            } catch (e) {
                // ignore malformed messages
            }
        });

        socket.addEventListener('close', () => {
            setRealtimeStatus('reconnecting', 'text-warning fw-semibold');
            window.setTimeout(connectRealtime, 3000);
        });

        socket.addEventListener('error', () => {
            setRealtimeStatus('polling fallback', 'text-warning fw-semibold');
        });
    };

    connectRealtime();
</script>

{% endblock %}
