{% extends 'base.html.twig' %}

{% block title %}Checkout - Jelo's Cafe{% endblock %}

{% block body %}
<section class="gradient-hero mb-5 text-white">
    <p class="section-subtitle text-white-75">Secure checkout</p>
    <h1 class="display-4 fw-bold mb-3">Checkout</h1>
    <p class="lead text-white-75 mb-0">Confirm your order, then stop by for your freshly roasted cup and pastry.</p>
</section>

<section class="page-section">
    {% if cart is empty %}
        <div class="text-center py-5">
            <div class="display-6 mb-3">🛒</div>
            <h3 class="fw-semibold mb-2">Nothing in your cart</h3>
            <p class="text-muted mb-4">Add a latte, cold brew, or pastry to place an order.</p>
            <a href="{{ path('menu') }}" class="btn btn-warning btn-lg">Browse the menu</a>
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 24px;">
                    <div class="card-body">
                        <p class="section-subtitle text-muted">Order summary</p>
                        <h5 class="section-heading mb-4">Items in your cart</h5>
                        <div class="d-flex flex-column gap-3">
                            {% for id, item in cart %}
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-semibold">{{ item.name }}</div>
                                        <small class="text-muted">x{{ item.quantity }}</small>
                                    </div>
                                    <div class="text-end">
                                        <div>₱{{ (item.price * item.quantity)|number_format(2, '.', ',') }}</div>
                                        <small class="text-muted">{{ item.category|default('Cafe order') }}</small>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4">
                            <span class="fw-semibold">Total</span>
                            <span class="fw-bold">₱{{ total|number_format(2, '.', ',') }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 24px;">
                    <div class="card-body">
                        <p class="section-subtitle text-muted">Tell us about yourself</p>
                        <h5 class="section-heading mb-4">Delivery or pickup info</h5>
                        <form method="post" action="{{ path('checkout') }}">
                            <div class="mb-3">
                                <label for="name" class="form-label">Full name *</label>
                                <input type="text" id="name" name="name" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="contact" class="form-label">Contact number *</label>
                                <input type="text" id="contact" name="contact" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="notes" class="form-label">Notes (optional)</label>
                                <textarea id="notes" name="notes" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="payment_method" class="form-label">Payment method *</label>
                                <select id="payment_method" name="payment_method" class="form-select" required>
                                    <option value="cash" selected>Cash</option>
                                    <option value="gcash">GCash</option>
                                    <option value="card">Card (on pickup)</option>
                                </select>
                                <small class="text-muted">Payment is recorded immediately after you place the order.</small>
                            </div>
                            <button type="submit" class="btn btn-warning btn-lg w-100">Place order</button>
                        </form>
                        <div class="mt-3 text-center">
                            <a href="{{ path('view_cart') }}" class="text-muted text-decoration-none">Back to cart</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
