{% extends 'base_admin.html.twig' %}
{% block title %}Manage Orders{% endblock %}
{% block header %}Customer Orders{% endblock %}

{% block body %}
<div class="card shadow-sm">
    <div class="card-body">
        <table id="orderTable" class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>{{ order.id }}</td>
                        <td>{{ order.customerName }}</td>
                        <td>₱{{ order.totalPrice|number_format(2, '.', ',') }}</td>
                        <td>{{ order.createdAt ? order.createdAt|date('M d, Y h:i A') : '-' }}</td>
                        <td class="text-end">
                            <a href="{{ path('admin_order_show', { id: order.id }) }}"
                               class="btn btn-sm btn-info text-white">
                                <i class="bi bi-eye"></i>
                            </a>

                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_order_delete', { id: order.id }) }}"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Delete order?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">No orders found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {% if orders is not empty %}
        <script>
            $(document).ready(function() {
                $('#orderTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [10, 25, 50],
                    ordering: true
                });
            });
        </script>
    {% endif %}
{% endblock %}
