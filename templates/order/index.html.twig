{% extends 'base.html.twig' %}

{% block title %}My Orders - Jelo's Cafe{% endblock %}

{% block body %}
<section class="gradient-hero mb-5 text-white">
    <p class="section-subtitle text-white-75">Order history</p>
    <h1 class="display-4 fw-bold mb-3">My orders</h1>
    <p class="lead text-white-75 mb-0">Track every batch you have reserved, scheduled, or enjoyed with us.</p>
</section>

<section class="page-section">
    {% if orders is not empty %}
        <div class="row row-cols-1 row-cols-md-2 g-4">
            {% for order in orders %}
                <article class="menu-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-semibold mb-0">Order #{{ order.id }}</h3>
                        <span class="text-muted small">{{ order.createdAt|date('M j, Y H:i') }}</span>
                    </div>
                    <p class="text-muted mb-2">{{ order.notes ?: 'No additional notes.' }}</p>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="price-tag">&#8369;{{ order.totalPrice|number_format(2, '.', ',') }}</span>
                        <span class="text-warning small fw-semibold">Recorded</span>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-5">
            <div class="display-6 mb-3">&#127864;</div>
            <h3 class="fw-semibold mb-2">No orders yet</h3>
            <p class="text-muted mb-4">Looks like you haven't placed an order yet. Check out our menu to get started.</p>
            <a href="{{ path('menu') }}" class="btn btn-warning btn-lg">Browse the menu</a>
        </div>
    {% endif %}
</section>
{% endblock %}
