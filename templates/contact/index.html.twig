{% extends 'base.html.twig' %}
{% block title %}Contact Us - Jelo's Cafe{% endblock %}

{% block body %}
<section class="gradient-hero mb-5 text-white">
    <p class="section-subtitle text-white-75">Reach out</p>
    <h1 class="display-4 fw-bold mb-3">Contact the roastery</h1>
    <p class="lead text-white-75 mb-0">Questions, feedback, or group reservations? We respond within one business day.</p>
</section>

<section class="page-section">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius: 24px;">
                <div class="card-body">
                    <p class="section-subtitle text-muted">Get in touch</p>
                    <h5 class="section-heading mb-3">We're listening</h5>
                    <p class="mb-1"><strong>Email:</strong> hello@jeloscafe.test</p>
                    <p class="mb-1"><strong>Phone:</strong> (02) 8123 4567</p>
                    <p class="mb-1"><strong>Visit:</strong> 123 Brew Street, Downtown</p>
                    <p class="mb-0"><strong>Hours:</strong> Mon-Fri 7:00 AM - 9:00 PM • Sat-Sun 8:00 AM - 10:00 PM</p>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div id="contact-form" class="card border-0 shadow-sm h-100" style="border-radius: 24px;">
                <div class="card-body">
                    <h5 class="section-heading mb-3">Send a message</h5>

                    {% if contact_form_embed_url is empty %}
                        <div class="alert alert-warning mb-0">
                            Add your form embed URL to <code>CONTACT_FORM_EMBED_URL</code> in the <code>.env</code> file.
                        </div>
                    {% else %}
                        <div class="ratio ratio-4x3 rounded-4 overflow-hidden">
                            <iframe
                                src="{{ contact_form_embed_url }}"
                                title="Contact form"
                                loading="lazy"
                                frameborder="0"
                                allowfullscreen>
                            </iframe>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
