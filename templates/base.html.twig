<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Jelo's Café{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Fonts for a café vibe -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f5f2;
            color: #333;
        }

        /* Navbar */
        .navbar {
            background-color: #4b2e05; /* Coffee brown */
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 0.5px;
        }

        .nav-link {
            color: #f8f5f2 !important;
            transition: 0.3s ease;
        }

        .nav-link:hover {
            color: #ffce7a !important;
        }

        /* Main container */
        .container {
            margin-top: 40px;
            margin-bottom: 60px;
        }

        /* Footer */
        footer {
            background-color: #4b2e05;
            color: #f8f5f2;
            padding: 20px 0;
            text-align: center;
            font-size: 0.9rem;
            letter-spacing: 0.3px;
        }

        footer a {
            color: #ffce7a;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        /* Flash messages */
        .flash-message {
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('homepage') }}">☕ Jelo's Café</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="{{ path('homepage') }}">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('menu') }}">Menu</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('view_cart') }}">🛒 Cart</a></li>
                   <li class="nav-item"><a class="nav-link" href="{{ path('my_orders') }}">📦 My Orders</a></li>


                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash messages -->
    <div class="container mt-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} flash-message text-center shadow-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Main content -->
    <div class="container">
        {% block body %}{% endblock %}
    </div>

    <!-- Footer -->
    <footer>
        <p>© {{ "now"|date("Y") }} Jelo's Café • Crafted with ❤️ by Jelo</p>
        <p><a href="#">Back to top</a></p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
