<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Date</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for order in orders %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.customerName }}</td>
                <td>₱{{ order.totalPrice|number_format(2, '.', ',') }}</td>
                <td>{{ order.createdAt|date('M d, Y') }}</td>
                <td class="text-end">
                    <a href="{{ path('admin_order_show', { id: order.id }) }}" 
                       class="btn btn-sm btn-info text-white">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted">No recent orders.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
