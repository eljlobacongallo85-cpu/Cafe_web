{% extends 'base_admin.html.twig' %}
{% block title %}Order #{{ order.id }}{% endblock %}
{% block header %}Order #{{ order.id }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6>Customer</h6>
                <p><strong>{{ order.customerName }}</strong><br>{{ order.contact }}</p>
                <h6>Notes</h6>
                <p>{{ order.notes|default('—') }}</p>
            </div>
        </div>

        <a href="{{ path('admin_order_index') }}" class="btn btn-outline-secondary">← Back to orders</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_order_delete',{id:order.id}) }}" class="btn btn-danger" onclick="return confirm('Delete this order?');">Delete</a>
        {% endif %}
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6>Items</h6>
                <table class="table">
                    <thead><tr><th>Product</th><th>Qty</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>
                        {% for item in order.items %}
                            <tr>
                                <td>{{ item.product.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td class="text-end">₱{{ item.subtotal|number_format(2, '.', ',') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr><th colspan="2">Total</th><th class="text-end">₱{{ order.totalPrice|number_format(2, '.', ',') }}</th></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
