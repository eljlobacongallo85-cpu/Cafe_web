{% extends 'base.html.twig' %}

{% block title %}Owner Dashboard{% endblock %}

{% block body %}
<div class="card shadow-lg p-4">
    <h1 class="mb-4 text-primary">📊 Owner Dashboard</h1>

    <div class="row">
        <div class="col-md-4">
            <div class="alert alert-success text-center">
                <h4>Sales Today</h4>
                <p class="display-6">₱{{ salesToday }}</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-info text-center">
                <h4>Top Product</h4>
                <p class="h3">{{ topProduct }}</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-warning text-center">
                <h4>Donation (10%)</h4>
                <p class="h3">₱{{ donationAmount }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
