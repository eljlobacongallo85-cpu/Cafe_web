<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

        <meta charset="UTF-8">
        <title>{% block title %}Cafe Dashboard{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="/">Cafe System</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="{{ path('owner_dashboard') }}">Owner Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('worker_dashboard') }}">Worker Dashboard</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
