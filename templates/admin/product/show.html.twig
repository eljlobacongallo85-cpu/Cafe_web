{% extends 'base_admin.html.twig' %}
{% block title %}Product: {{ product.name }}{% endblock %}
{% block header %}{{ product.name }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm">
            {% if product.image %}
                <img src="{{ product.image }}" class="card-img-top" style="height:320px; object-fit:cover;">
            {% endif %}
            <div class="card-body">
                <h5 class="card-title">{{ product.name }}</h5>
                <p class="text-muted">{{ product.category|default('Uncategorized') }}</p>
                <p class="h5">₱{{ product.price|number_format(2, '.', ',') }}</p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('admin_product_edit',{id:product.id}) }}" class="btn btn-warning">Edit</a>
                <a href="{{ path('admin_product_delete',{id:product.id}) }}" class="btn btn-danger" onclick="return confirm('Delete this product?');">Delete</a>
                <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary mb-3">
    &larr; Back to list
</a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6>Description</h6>
                <p>{{ product.description|default('No description') }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
