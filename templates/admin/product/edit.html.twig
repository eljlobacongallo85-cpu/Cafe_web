{# templates/admin/product/new.html.twig (also used as edit) #}
{% extends 'base_admin.html.twig' %}
{% block title %}{{ product is defined ? 'Edit' : 'Add' }} Product{% endblock %}
{% block header %}{{ product is defined ? 'Edit Product' : 'Add Product' }}{% endblock %}

{% block body %}
<div class="card shadow-sm p-4">

    {{ form_start(form) }}

    <div class="row g-4">

        <div class="col-md-8">

            <div class="mb-3">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 5 } }) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.category) }}
                {{ form_widget(form.category, { attr: { class: 'form-select' } }) }}
                {{ form_errors(form.category) }}
            </div>

        </div>

        <div class="col-md-4">

            <div class="mb-3">
                {{ form_label(form.price) }}
                {{ form_widget(form.price, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.price) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.image) }}
            </div>

        </div>

    </div>

    <div class="mt-4">
        <button class="btn btn-primary">Save</button>
        <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary">Cancel</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
